    "web-vitals": "^4.2.4"
  },
  "scripts": {
    "start": "cross-env PORT=4200 react-scripts start",
    "build": "react-scripts build",
    "test": "jest --ci --reporters=default --outputFile=frontend-test-results.xml --watchAll=false --passWithNoTests",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage --reporters=default --reporters=jest-junit --outputFile=frontend-test-coverage-results.xml",
    "eject": "react-scripts eject",
    "lint": "eslint . --fix",
    "sonar": "sonar-scanner",
    "postinstall": "npm install lucide-react"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@babel/preset-env": "^7.26.9",
    "@babel/preset-react": "^7.26.3",
    "@eslint/js": "^9.22.0",
