    "file-saver": "^2.0.5",
    "lucide-react": "^0.487.0",
    "mock-css-modules": "^2.0.0",
    "mui": "^0.0.1",
    "react": "^18.3.1",
    "react-confetti": "^6.4.0",
    "react-device-detect": "^2.2.3",
    "react-dom": "^18.3.1",
    "react-google-signin-button": "^1.1.0",
    "react-icons": "^5.5.0",
    "react-router-dom": "^6.30.0",
    "react-scripts": "^5.0.1",
    "react-sitemap-generator": "^1.1.6",
