############################################################## 
###                    CONFIGURATION GÉNÉRALE              ### 
############################################################## 

APP_NAME=tip-top-game 
DOMAIN=dsp5-archi-f24a-15m-g3.fr 
DOCKER_NETWORK=tiptopgame_net 
TIMEZONE=Europe/Paris 
TRAEFIK_EMAIL=thierry.temgoua98@gmail.com

############################################################## 
###                  INFOS D'ENVIRONNEMENT                 ### 
############################################################## 

ENVIRONMENT=dev  # Cette valeur est dynamique en fonction de la branche Jenkins

# Docker Compose project name
COMPOSE_PROJECT_NAME=${APP_NAME}_${ENVIRONMENT}

############################################################## 
###                INFORMATIONS SYSTÈME / IMAGES          ### 
############################################################## 

NODE_VERSION=20 
REACT_VERSION=18 
MONGO_VERSION=7 
SONARQUBE_VERSION=10.2.1-community 
GRAFANA_VERSION=10.0.3 
JENKINS_VERSION=2.414.1-lts

############################################################## 
###                PORTS PAR DÉFAUT (LOCAUX)              ### 
############################################################## 

FRONTEND_PORT=3000 
BACKEND_PORT=4000 
MONGO_PORT=27017 
SONARQUBE_PORT=9000 
GRAFANA_PORT=3001 
JENKINS_PORT=8080

############################################################## 
###                    IDENTIFIANTS SÉCURISÉS             ### 
###             (Ne pas versionner en clair, à injecter)  ### 
############################################################## 

MONGO_USER=root 
MONGO_PASSWORD=password 
MONGO_DB=tip_top_game

DEFAULT_ADMIN_USER=admin 
DEFAULT_ADMIN_PASSWORD=admin

# Jenkins Credentials
JENKINS_GIT_CREDENTIAL_ID=gitlab-token
JENKINS_DOCKER_CREDENTIAL_ID=dockerhub-credentials
JENKINS_SONARQUBE_ID=SonarQubeServer

############################################################## 
###         CONFIGURATION DOCKERHUB / CI/CD               ### 
############################################################## 

DOCKER_REGISTRY=docker.io

# Docker images tags
DOCKER_IMAGE_BACKEND=${DOCKER_REGISTRY}/${APP_NAME}:backend-${ENVIRONMENT}
DOCKER_IMAGE_FRONTEND=${DOCKER_REGISTRY}/${APP_NAME}:frontend-${ENVIRONMENT}

# Docker credentials to be injected by Jenkins credentials
DOCKER_USERNAME=__INJECTED_FROM_CREDENTIALS__
DOCKER_PASSWORD=__INJECTED_FROM_CREDENTIALS__
